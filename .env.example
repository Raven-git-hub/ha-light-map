# Light Map: Home Assistant connection. Copy to .env (git-ignored) and fill in.
# The token is read from here at runtime and is never written into the config.

# Base URL of your Home Assistant instance. Overrides homeassistant.base_url in the config.
LM_HA_BASE_URL=http://homeassistant.local:8123

# A long-lived access token: set LM_HA_TOKEN, or point LM_HA_TOKEN_FILE at a file that
# holds it (see the secrets block in docker-compose.yml).
LM_HA_TOKEN=
# LM_HA_TOKEN_FILE=/run/secrets/lm_ha_token

# Where the committed config lives. The default is the container's /data volume; outside
# the container, point it somewhere writable (e.g. data/config.json).
# LM_CONFIG_PATH=/data/config.json

# The host names (or addresses) you browse to Light Map by, comma-separated. Requests for
# any other Host are refused, which blocks DNS-rebinding pages; localhost and 127.0.0.1 are
# always allowed. Needed as soon as you open the Map from another machine.
# LM_ALLOWED_HOSTS=lightmap.lan,192.168.1.20
